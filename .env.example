# Resend API key (server-side only) — required for the quote form (/api/quote)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Verified sender address. Defaults to the send.compassmarketing.ai sender
# below; switch to a verified sender on the business's own domain when ready.
RESEND_FROM=Pensacola Equipment Rentals <quotes@send.compassmarketing.ai>

# Where quote requests are delivered (comma-separated for multiple).
QUOTE_RECIPIENT=bnbcoastalcuts@gmail.com,thomas@compassmarketing.ai

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Optional: without it no
# analytics tag loads. Phone-link clicks are sent as `phone_click` and quote
# submissions as `form_submit`.
NEXT_PUBLIC_GA_ID=
